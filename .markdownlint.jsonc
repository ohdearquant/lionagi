{
  "default": true,
  "MD013": false,
  "MD033": false,
  "MD041": false,
  "MD024": { "siblings_only": true },
  "MD034": false,
  "MD036": false,
  "MD046": { "style": "fenced" },

  // MD060/table-column-style is disabled deliberately, not to make this gate
  // pass quietly.
  //
  // The rule is new in markdownlint v0.41, which is what the CI action resolves
  // to; the version pinned for the pre-commit hook does not have it at all. With
  // it enabled, the documentation set reports 3516 violations, all of them pipe
  // spacing. The rule's default style is "any", which reports only tables that
  // match none of the supported styles, so those tables really are inconsistent
  // with themselves rather than merely written in a house style the rule
  // dislikes.
  //
  // What this does not give up: MD060 governs pipe spacing only. Table
  // structure is still checked, by MD055 for pipe style and MD056 for column
  // count, and both stay on. A row with the wrong number of cells is still an
  // error. What stops being reported is padding.
  //
  // Reformatting the tables is worth doing and is not this file's decision to
  // make implicitly. Re-enabling means fixing them first, in a change whose
  // subject is the tables; drop this entry in that change rather than
  // separately, so the rule and the formatting land together.
  "MD060": false
}
